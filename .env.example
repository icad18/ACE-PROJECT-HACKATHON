# ==============================================================================
# ACE × IBM Bob × Langflow × GitHub — Environment Variables
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# PENTING: Jangan pernah commit file .env ke repository!
# ==============================================================================

# ==============================================================================
# LLM — Google Gemini API (Free Tier)
# Dapatkan API key gratis dari: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ACE menggunakan dual-key rotation untuk Gemini (opsional, untuk kapasitas lebih)
GEMINI_API_KEY_1="your_gemini_api_key_primary_here"
GEMINI_API_KEY_2="your_gemini_api_key_secondary_here"

# ==============================================================================
# GitHub — Repository & Authentication
# Buat Fine-grained PAT di: GitHub → Settings → Developer settings → Fine-grained tokens
# Permission: Contents (R/W) + Pull requests (R/W) + Metadata (R)
# ==============================================================================
GITHUB_PERSONAL_ACCESS_TOKEN="github_pat_your_token_here"
GITHUB_REPO_OWNER="your-github-username"
GITHUB_REPO_NAME="your-repository-name"

# Token lama (kompatibilitas dengan kode ACE yang sudah ada)
GITHUB_TOKEN=""
GITHUB_DEFAULT_OWNER=""

# ==============================================================================
# Langflow OSS — Orchestration Layer
# URL default: http://localhost:7860 (jika berjalan via Docker)
# ==============================================================================
LANGFLOW_API_KEY="DGB4xmjFOvd8uCeVaZK7J9doX4DwBRZzv5pPfI5LAag"
LANGFLOW_MCP_URL="http://localhost:7860/api/v1/mcp/streamable"
LANGFLOW_SECRET_KEY="862ad466fe27ec0007d80ca89c885389d9d7e1aeb46572f258b66d9c153c4632"
LANGFLOW_AUTO_LOGIN="false"

# ==============================================================================
# GitHub MCP Server — GitHub Bridge
# URL default: http://localhost:8080 (jika berjalan via Docker)
# ==============================================================================
GITHUB_MCP_URL="http://localhost:8080"

# ==============================================================================
# ACE MCP Server — ACE Tool Layer
# URL default: http://localhost:8765
# Buat token random yang kuat, contoh: openssl rand -hex 32
# ==============================================================================
ACE_MCP_URL="http://localhost:8765"
MCP_AUTH_TOKEN="your_random_secret_token_here"

# ==============================================================================
# ACE Runtime Settings
# ==============================================================================
ACE_DATA_DIR="~/.ace/data"
ACE_PLUGINS_DIR="~/.ace/plugins"
ACE_LOG_LEVEL="INFO"
ACE_DEFAULT_LOCALE="id"  # "id" untuk Bahasa Indonesia, "en" untuk English

# ==============================================================================
# Ollama — Local LLM Fallback (opsional)
# Install: https://ollama.com/
# ==============================================================================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LOCAL_MODEL="qwen2.5-coder:3b"
OLLAMA_API_KEY=""

# ==============================================================================
# Observability — Arize Phoenix (opsional)
# ==============================================================================
PHOENIX_PORT=6006
PHOENIX_ENABLE=true
